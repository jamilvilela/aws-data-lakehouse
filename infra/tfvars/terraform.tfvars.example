# Example Terraform variables file.
# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored and must never be committed (it may contain
# account IDs and other sensitive values).

datalake_role_name = ""
datalake_policy_name = ""
# Only the role name is required here; the full ARN is assembled in
# infra/locals.tf using the current AWS account ID.
datalake_job_role_name = ""

buckets = {
  workspace = "lakehouse-workspace"
  landing   = "lakehouse-landing"
  raw       = "lakehouse-raw"
  trusted   = "lakehouse-trusted"
  business  = "lakehouse-business"
}

databases = {
  raw      = "db_raw"
  trusted  = "db_trusted"
  business = "db_business"
}

tables = {
  tbl_aircraft           = "tbl_aircraft"
  tbl_airports           = "tbl_airports"
  tbl_airlines           = "tbl_airlines"
  tbl_flights            = "tbl_flights"
  tbl_aircraft_positions = "tbl_aircraft_positions"
  tbl_countries          = "tbl_countries"
  tbl_aircraft_types     = "tbl_aircraft_types"
  tbl_routes             = "tbl_routes"
  etl_control            = "etl_control"
  data_quality           = "data_quality_metrics"
  rejected_records       = "tbl_rejected_records"
}

# Usuários criados no IAM
# Estes usuários serão adicionados automaticamente aos grupos correspondentes
users = {
  datalake_admin = {
    name = ""
  }
  datalake_user1 = {
    name = ""
  }
}